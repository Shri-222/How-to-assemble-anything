# Server Config
PORT=5000
NODE_ENV=development

# Database
MONGO_URL=mongodb+srv://<username>:<password>@cluster.mongodb.net/assemble-it

# Cloudinary (Used for storing user scrap photos)
CLOUDINARY_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# AI Brain
GEMINI_API_KEY=your_google_ai_key

# Firebase Admin (Get these from Project Settings > Service Accounts)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com

# Important: Use quotes for the Private Key to handle the \n characters
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgkqhkiG9w0BAQEFAASCBKcwggSjAgEAAoIBAQ..."